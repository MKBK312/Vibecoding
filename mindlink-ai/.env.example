# ============================================
# MindLink AI 局域网部署配置
# 复制此文件为 .env 并修改
# cp .env.example .env
# ============================================

# 宿主机局域网 IP（必填）
LAN_IP=192.168.1.100

# MySQL 配置
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=mindlink
MYSQL_PASSWORD=mindlink123

# LLM 后端选择 (ollama 或 claude)
LLM_BACKEND=ollama

# Claude/DeepSeek API（仅 LLM_BACKEND=claude 时需要）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=DeepSeek-V4-Pro
ANTHROPIC_AUTH_TOKEN=your-api-key-here
